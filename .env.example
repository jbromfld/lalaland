# Docker Compose example. Copy to .env for a new installation and edit it.
# For native Python processes, export variables and replace host.docker.internal
# with 127.0.0.1 for services running on this machine.

# Existing Postgres database: replace the example role/password with your own.
# URL-encode special characters in database credentials.
DATABASE_URL=postgresql://lalaland:change-me@host.docker.internal:5432/lalaland

# Shared local services.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Experimental alternative: run vLLM separately on the host (see docs/vllm.md).
# INFERENCE_PROVIDER=vllm
# VLLM_BASE_URL=http://host.docker.internal:8001/v1
# VLLM_MODEL=local-model
# VLLM_API_KEY=your-server-key
# With vLLM, CORPUS_MODEL defaults to VLLM_MODEL unless explicitly set below.
TEMPORAL_ADDRESS=host.docker.internal:30733
TEMPORAL_NAMESPACE=lalaland

# Dashboard: http://127.0.0.1:8081; backend: http://127.0.0.1:8000.
BACKEND_PORT=8000
FRONTEND_PORT=8081

# Optional overrides below. Leave commented to use Settings defaults in
# backend/config.py. Models must be available on the selected inference server.
# Model versions are intentionally not pinned here; config.py owns the defaults.

# LA-1: RSS briefing.
# OLLAMA_MODEL=your-installed-rss-model
# OLLAMA_TIMEOUT_SECONDS=120
# SCHEDULE_HOUR=6
# SCHEDULE_MINUTE=0
# SCHEDULE_TIMEZONE=America/Detroit
# The default timezone setting is "local", which leaves Temporal on UTC.
# An explicit timezone above changes the local hour for a newly created schedule.
# Changing these settings does not update an existing LA-1 schedule.

# LA-2: research corpus. Start/end hours must be within the same day.
# DNS domains trust the domain and its subdomains. No URLs or wildcards; empty trusts none.
# CORPUS_TRUSTED_DOMAINS=arxiv.org,neurips.cc
# CORPUS_MODEL=your-installed-research-model
# CORPUS_SCHEDULE_HOUR=3
# CORPUS_END_HOUR=5
# CORPUS_SCHEDULE_TIMEZONE=America/Detroit
# CORPUS_OLLAMA_TIMEOUT_SECONDS=300
# CORPUS_FINAL_TIMEOUT_SECONDS=900
# CORPUS_FINAL_NUM_PREDICT=6144
# Keep inference timeouts below the 1200-second worker heartbeat interval.

# Application identity.
# APP_TITLE="Research Briefing"
# OTEL_SERVICE_NAME=research-briefing

# Optional OTLP/HTTP trace destination. Unset uses the console exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces

# Shared lassy retrieval service base URL (not /query). Unset disables delivery.
# Compose lassy defaults to host port 8082; native lassy may use another port.
# KNOWLEDGE_SERVICE_URL=http://host.docker.internal:8082
# KNOWLEDGE_TIMEOUT_SECONDS=120
